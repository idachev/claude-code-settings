# Secrets — NEVER commit
.credentials.json

# Runtime conversation/session state
projects/
history.jsonl
sessions/
session-env/
shell-snapshots/
todos/
tasks/
teams/
file-history/

# Managed by plugin system (large, reproducible)
plugins/

# Caches
cache/
paste-cache/
stats-cache.json
mcp-needs-auth-cache.json

# Logs / telemetry / stats
logs/
debug/
telemetry/
usage-data/
statsig/
nwave-install.log

# Backups / downloads / IDE state
backups/
downloads/
ide/

# Runtime policy state
policy-limits.json

# Updater / cleanup / daemon / jobs runtime state
.last-cleanup
.last-update-result.json
daemon.log
daemon/
jobs/

# Security guidance plugin state (old root location + new security/ dir, incl. its venv)
security_warnings_state_*.json
security/

# Pre-push review tooling — installed/managed externally
prepush-review/

# Stray nested dir
.claude/

# Shared agent skills + their version lock. The `skills` CLI writes these into
# whatever directory it is run from, so running it here instead of from $HOME
# drops a nested copy the symlinks do not point at -- never commit one.
.agents/
skills-lock.json

# Project-specific notes
plans/

.serena

image-cache/

# Derived state / backups that can capture per-project data
gh-pr-status-cache.json
settings.json.bak*
.claude.json.bak*

# Live Claude Code state: OAuth session, identifiers, every local project.
# The versionable slice is snapshotted to .claude-git.json by a pre-commit hook.
.claude.json

# Local cache of organization-managed policy settings, fetched from the Anthropic
# API and rewritten by Claude Code (mode 0600). It is the highest-priority layer
# in the settings merge, so it can carry org-pushed hosts, proxies and tool
# policy. Empty today; never commit whatever an org pushes into it tomorrow.
remote-settings.json
