      "mcp__context7__query-docs",
      "mcp__javadc__decompile-from-jar",
      "mcp__javadc__decompile-from-package",
      "mcp__postgres__query",
      "WebFetch(domain:developer.superdispatch.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.orderful.com)",
      "WebFetch(domain:docs.quarkiverse.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:java.testcontainers.org)",
