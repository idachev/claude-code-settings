{
  "cleanupPeriodDays": 365,
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(./build-dev.sh:*)",
      "Bash(./build-project.sh:*)",
      "Bash(./mvnw:*)",
      "Bash(bd:*)",
      "Bash(cat:*)",
      "Bash(command cat:*)",
      "Bash(command find:*)",
      "Bash(command grep:*)",
      "Bash(command head:*)",
      "Bash(command ls:*)",
      "Bash(command tail:*)",
