{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@v1.7.0",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "claude-code",
        "--open-web-dashboard",
        "False"
      ],
      "env": {}
    },
    "textbook-catalog": {
      "type": "http",
      "url": "https://textbook-catalog.igdoptin.workers.dev/mcp",
      "headers": {
        "X-API-Key": "${TC_API_KEY}"
      }
    }
  }
}
